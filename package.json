{
  "name": "monitoringdashboardcodebasearchitecture",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "MonitoringDashboardClientServiceLayerMSC",
    "MonitoringDashboardOrchestratorServiceLayerMSC"
  ],
  "scripts": {
    "start:dev": "turbo dev",
    "start:build": "turbo build",
    "start:lint": "turbo lint",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "client:dev": "turbo dev --filter=@monitoring-dashboard/client",
    "client:build": "turbo build --filter=@monitoring-dashboard/client",
    "client:lint": "turbo lint --filter=@monitoring-dashboard/client",
    "client:install": "bun install --cwd MonitoringDashboardClientServiceLayerMSC",
    "server:dev": "turbo dev --filter=@monitoring-dashboard/server",
    "server:build": "turbo build --filter=@monitoring-dashboard/server",
    "server:lint": "turbo lint --filter=@monitoring-dashboard/server",
    "install:deps": "bun install && bun run --cwd MonitoringDashboardOrchestratorServiceLayerMSC prisma:generate",
    "smoke:test:headed": "bun run --cwd MorningSmokeTestAutomation test:headed"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
