# Which environment to run against - set by the test:headed:<env> scripts
# themselves (see package.json), not usually set by hand here. One of:
# Training, Production, QA, Dev1, Testing, Dev2.
SMOKE_ENV=QA
SMOKE_USER=your-username
SMOKE_PASS=your-password

# Supabase Postgres connection strings — from Supabase dashboard →
# Project Settings → Database.
# DATABASE_URL: Supavisor transaction-mode pooler (port 6543), used at runtime.
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: direct connection (port 5432), used only for migrations.
#   postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=
DIRECT_URL=

# 32-byte hex key used to encrypt/decrypt the password field. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=
