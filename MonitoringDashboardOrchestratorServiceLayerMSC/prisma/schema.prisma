// Most of this schema mirrors tables owned and migrated by
// MorningSmokeTestAutomation (a separate repo/process) - this backend is
// read-only with respect to THOSE tables; never run `prisma migrate` here
// for them. The push-notification and application-monitor models below are
// the exception: they belong to this backend alone (concerns the automation
// script has no reason to know about), so this backend owns and evolves
// them - but still never via `prisma migrate`, since that would collide with
// MorningSmokeTestAutomation's own tracked migration history in this same
// database. See prisma/manual-sql/ for how they were created, and add future
// changes to these models the same way (raw SQL, applied by hand, then
// `prisma generate`).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  PRODUCTION
  QA
  TESTING
  TRAINING
  DEV1
  DEV2
}

model TestRun {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  environment Environment?

  pingChecks              AuthenticationPingCheck[]
  loginChecks             AuthenticationLoginCheck[]
  pageLoadChecks          PageLoadCheck[]
  indexingFreshnessChecks IndexingFreshnessCheck[]
  queueStatusChecks       QueueStatusCheck[]
  inProgressChecks        InProgressCheck[]

  @@map("MD_TestRunTBL")
}

model InProgressCheck {
  id        String   @id @default(cuid())
  checkName String
  startedAt DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@unique([testRunId, checkName])
  @@map("MD_InProgressCheckTBL")
}

model AuthenticationPingCheck {
  id         String   @id @default(cuid())
  success    Boolean
  message    String
  statusCode Int?
  createdAt  DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_AuthenticationPingCheckTBL")
}

model AuthenticationLoginCheck {
  id        String   @id @default(cuid())
  username  String
  password  String
  success   Boolean
  message   String
  createdAt DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_AuthenticationLoginCheckTBL")
}

model PageLoadCheck {
  id              String   @id @default(cuid())
  pageName        String
  success         Boolean
  message         String
  technicalReason String?
  statusCode      Int?
  durationMs      Int?
  createdAt       DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_PageLoadCheckTBL")
}

model IndexingFreshnessCheck {
  id             String   @id @default(cuid())
  resultCount    Int      @map("result_count")
  indexTime      DateTime @map("index_time")
  machineTime    DateTime @map("machine_time")
  timeDifference Float    @map("time_difference")
  isFresh        Boolean  @map("is_fresh")
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  testRunId String  @map("test_run_id")
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_IndexingFreshnessCheckTBL")
}

model QueueStatusCheck {
  id                String   @id @default(cuid())
  pageName          String
  state             String
  lessThan10Min     String
  lessThan1Hour     String
  lessThan4Hours    String
  greaterThan4Hours String
  createdAt         DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_QueueStatusCheckTBL")
}

// One row per browser that has granted notification permission and
// subscribed. There's no login system, so this is per-device, not
// per-person - every subscribed browser gets every Degraded/Failed push.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  createdAt DateTime @default(now())

  @@map("MD_PushSubscriptionTBL")
}

// Single-row cursor (id is always 1) - the most recent run a push has
// already been sent for, so a check running every few minutes doesn't
// re-notify for the same run on every tick before the next real smoke test.
model NotificationCheckpoint {
  id                Int      @id @default(1)
  lastNotifiedRunId String?
  updatedAt         DateTime @updatedAt

  @@map("MD_NotificationCheckpointTBL")
}

// One row per sibling application ObservaCore monitors (AssetSphere,
// SignForge, ...) - not just AssetSphere's endpoints specifically, so a
// second app's rows are just a second seeded Application + its Endpoints,
// no schema change.
model MonitoredApplication {
  id        String   @id @default(cuid())
  // Stable, code-facing identifier (matches NavigationCON's nav item id,
  // e.g. "assetsphere") - the display name can change without touching this.
  slug      String   @unique
  name      String
  baseUrl   String
  // A lucide-react icon name (e.g. "Boxes"), rendered the same way
  // NavigationCON's own NavItemDef icons are.
  iconName  String?
  createdAt DateTime @default(now())

  endpoints ApplicationEndpoint[]

  @@map("MD_ApplicationConstantTBL")
}

// One row per check an application exposes (a health check, a ping, and -
// later - a database connection check or similar). `config` is free-form
// JSON text whose shape depends on `checkType`, so a new check type never
// needs a schema change, only a new checkType value and a different config
// shape (see ApplicationMonitorService's HttpEndpointConfig for today's
// only shape).
model ApplicationEndpoint {
  id            String   @id @default(cuid())
  applicationId String
  application   MonitoredApplication @relation(fields: [applicationId], references: [id])

  label      String
  // "HttpEndpoint" is the only value today.
  checkType  String
  config     String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  hitHistory ApplicationEndpointHit[]

  @@map("MD_ApplicationEndpointConstantTBL")
}

// One row per time a check button was actually clicked - a history of real
// hits, not a scheduled/synthetic monitor.
model ApplicationEndpointHit {
  id           String   @id @default(cuid())
  endpointId   String
  endpoint     ApplicationEndpoint @relation(fields: [endpointId], references: [id])

  success      Boolean
  statusCode   Int?
  // JSON text of whatever the endpoint returned, truncated at the service
  // layer if it's ever unexpectedly huge.
  responseBody String?
  durationMs   Int
  errorMessage String?
  checkedAt    DateTime @default(now())

  @@map("MD_ApplicationEndpointHitHistoryTBL")
}

// Fixed, admin-seeded list of Windows VMs reachable only via the relay
// (see ClientMachineServices feature) - never user-editable from the UI.
model ClientMachine {
  id        String   @id @default(cuid())
  hostname  String   @unique
  nickname  String
  createdAt DateTime @default(now())

  actions ClientMachineServiceAction[]

  @@map("MD_ClientMachineConstantTBL")
}

// Generic key-value configuration store - same shape as AssetSphere's
// AS_ConfigurationConstantTBL and SignForge's SF_ConfigurationConstantTBL
// (verified against SignForge's live schema), so this convention is
// identical across all 3 apps' own databases. Used here to hold the curated
// "default shown" services per machine: one row per machine, keyed
// "ClientMachineDefaultServices:<hostname>", value a JSON array of service
// names (see ClientMachineServicesService for the read path). A machine with
// no row here falls back to "Show all services" (a live, unfiltered sc.exe
// query) instead of an empty curated list.
model ConfigurationConstant {
  id                 String    @id @default(cuid())
  configurationKey   String    @unique
  configurationValue String
  description        String?
  isActive           Boolean   @default(true)
  createdBy          String    @default("system")
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("MD_ConfigurationConstantTBL")
}

// One row per Start/Stop/Restart attempt (not view/query actions) - who,
// when, which machine/service, what happened. "performedBy" is the real
// validated hostname\account username from the login JWT, never free text.
model ClientMachineServiceAction {
  id          String   @id @default(cuid())
  machineId   String
  machine     ClientMachine @relation(fields: [machineId], references: [id])

  serviceName  String
  // "Start" | "Stop" | "Restart"
  action       String
  performedBy  String
  performedAt  DateTime @default(now())
  succeeded    Boolean
  errorMessage String?
  durationMs   Int

  @@map("MD_ClientMachineServiceActionAuditTBL")
}

// One row per logged-in session (see the pre-navigation login gate PRD,
// section 3a). refreshTokenHash is a SHA-256 hash of the refresh token -
// never the raw token - so a DB leak alone can't be replayed. encryptedPassword
// is the real daily VM password, AES-256-GCM encrypted at rest (mirrors
// MorningSmokeTestAutomation's EncryptionHelper), needed so later visits can
// silently re-validate against the real VM without asking the user again.
model ClientMachineRefreshToken {
  id                String   @id @default(cuid())
  username          String
  refreshTokenHash  String   @unique
  encryptedPassword String
  issuedAt          DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@map("MD_ClientMachineRefreshTokenTBL")
}
