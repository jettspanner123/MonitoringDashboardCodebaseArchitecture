// Most of this schema mirrors tables owned and migrated by
// MorningSmokeTestAutomation (a separate repo/process) - this backend is
// read-only with respect to THOSE tables; never run `prisma migrate` here
// for them. The two push-notification models below are the exception: they
// belong to this backend alone (a pure dashboard/browser concern the
// automation script has no reason to know about), so this backend owns and
// evolves them - but still never via `prisma migrate`, since that would
// collide with MorningSmokeTestAutomation's own tracked migration history in
// this same database. See prisma/manual-sql/ for how they were created, and
// add future changes to these two models the same way (raw SQL, applied by
// hand, then `prisma generate`).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  PRODUCTION
  QA
  TESTING
  TRAINING
  DEV1
  DEV2
}

model TestRun {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  environment Environment?

  pingChecks              AuthenticationPingCheck[]
  loginChecks             AuthenticationLoginCheck[]
  pageLoadChecks          PageLoadCheck[]
  indexingFreshnessChecks IndexingFreshnessCheck[]
  queueStatusChecks       QueueStatusCheck[]
  inProgressChecks        InProgressCheck[]

  @@map("MD_TestRunTBL")
}

model InProgressCheck {
  id        String   @id @default(cuid())
  checkName String
  startedAt DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@unique([testRunId, checkName])
  @@map("MD_InProgressCheckTBL")
}

model AuthenticationPingCheck {
  id         String   @id @default(cuid())
  success    Boolean
  message    String
  statusCode Int?
  createdAt  DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_AuthenticationPingCheckTBL")
}

model AuthenticationLoginCheck {
  id        String   @id @default(cuid())
  username  String
  password  String
  success   Boolean
  message   String
  createdAt DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_AuthenticationLoginCheckTBL")
}

model PageLoadCheck {
  id              String   @id @default(cuid())
  pageName        String
  success         Boolean
  message         String
  technicalReason String?
  statusCode      Int?
  durationMs      Int?
  createdAt       DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_PageLoadCheckTBL")
}

model IndexingFreshnessCheck {
  id             String   @id @default(cuid())
  resultCount    Int      @map("result_count")
  indexTime      DateTime @map("index_time")
  machineTime    DateTime @map("machine_time")
  timeDifference Float    @map("time_difference")
  isFresh        Boolean  @map("is_fresh")
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  testRunId String  @map("test_run_id")
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_IndexingFreshnessCheckTBL")
}

model QueueStatusCheck {
  id                String   @id @default(cuid())
  pageName          String
  state             String
  lessThan10Min     String
  lessThan1Hour     String
  lessThan4Hours    String
  greaterThan4Hours String
  createdAt         DateTime @default(now())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  @@map("MD_QueueStatusCheckTBL")
}

// One row per browser that has granted notification permission and
// subscribed. There's no login system, so this is per-device, not
// per-person - every subscribed browser gets every Degraded/Failed push.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  createdAt DateTime @default(now())

  @@map("MD_PushSubscriptionTBL")
}

// Single-row cursor (id is always 1) - the most recent run a push has
// already been sent for, so a check running every few minutes doesn't
// re-notify for the same run on every tick before the next real smoke test.
model NotificationCheckpoint {
  id                Int      @id @default(1)
  lastNotifiedRunId String?
  updatedAt         DateTime @updatedAt

  @@map("MD_NotificationCheckpointTBL")
}
